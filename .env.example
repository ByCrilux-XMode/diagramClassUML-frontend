# --- API / WebSocket del backend ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# --- Proveedor por defecto ---
IA_DEFAULT_PROVIDER=hf-space
NEXT_PUBLIC_IA_DEFAULT_PROVIDER=hf-space
# Modelo real para el proveedor `huggingface` (router de Inferencia HF).
IA_DEFAULT_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# Modelo por defecto del proveedor `hf-space` (ID del selector).
IA_HF_SPACE_MODEL=piloto-qwen2.5coder
NEXT_PUBLIC_IA_HF_SPACE_MODEL=piloto-qwen2.5coder

# --- Modelo propio en Hugging Face (Space Gradio, endpoint /generate) ---
HF_SPACE_URL=https://alexsolizduran-piloto-qwen2-5coder.hf.space
NEXT_PUBLIC_HF_SPACE_URL=https://alexsolizduran-piloto-qwen2-5coder.hf.space
HF_SPACE_PROPIO_URL=https://alexsolizduran-piloto-qwen2-5coder.hf.space
NEXT_PUBLIC_HF_SPACE_PROPIO_URL=https://alexsolizduran-piloto-qwen2-5coder.hf.space
# DSL canónico (diagrama completo → diff → tools) solo para el Space propio.
# Activo por defecto; pon 0 para volver al parser JSON de siempre.
IA_HF_SPACE_DSL=1
NEXT_PUBLIC_IA_HF_SPACE_DSL=1
IA_HF_SPACE_DSL_MAX_TOKENS=1536
NEXT_PUBLIC_IA_HF_SPACE_DSL_MAX_TOKENS=1536

# --- OpenRouter (modelo fuerte; cuenta free: 50 peticiones/dia) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- Único modelo de OpenRouter de la app ---
# Ruta visión (foto -> proyecto) + apartado GRUPAL del asistente.
# Debe aceptar image input en OpenRouter (ver endpoint /endpoints del modelo).
IA_OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# --- Visión (foto -> proyecto) ---
# Tope de tokens de salida; un diagrama grande no cabe en los 2048 del chat.
IA_VISION_MAX_TOKENS=8192

# --- Contexto (fase 1) ---
IA_MAX_HISTORY_TURNS=6
IA_DEBUG_CONTEXT=0
IA_CONTEXT_HF_SPACE=4096
IA_CONTEXT_OPENROUTER=262144
IA_MAX_TOOL_ROUNDS=10
IA_CHAT_TIMEOUT_MS=120000

# --- Bitacora (fase 2) ---
IA_DEBUG_ACTIVIDAD=0
HF_STT_SPACE_URL=https://alexsolizduran-ia-voztotext.hf.space
